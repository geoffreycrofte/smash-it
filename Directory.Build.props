<Project>
  <PropertyGroup>
    <!-- Shared Windows target: WinRT APIs (WIC, Media Foundation) need a Windows TFM. -->
    <SmashItTargetFramework>net10.0-windows10.0.19041.0</SmashItTargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Authors>Geoffrey Crofte</Authors>
    <Product>Smash It</Product>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Version>0.5.0</Version>
    <!-- Product version "0.5.0", not "0.5.0+<commit>": code signing checks it against the release version. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
