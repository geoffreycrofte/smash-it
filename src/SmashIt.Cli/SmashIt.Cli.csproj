<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(SmashItTargetFramework)</TargetFramework>
    <RootNamespace>SmashIt.Cli</RootNamespace>
    <!-- Not "smashit": it would overwrite the app's SmashIt.exe once both share one folder (file names are
         case-insensitive). Releases ship a cmd\smashit.cmd shim so the command stays `smashit`. -->
    <AssemblyName>SmashIt.Cli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmashIt.Core\SmashIt.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="SmashIt.Core.Localization" />
  </ItemGroup>

</Project>
