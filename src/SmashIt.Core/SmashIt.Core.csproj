<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(SmashItTargetFramework)</TargetFramework>
    <RootNamespace>SmashIt.Core</RootNamespace>
    <SmashItToolsDir>$(MSBuildThisFileDirectory)..\..\tools\bin\</SmashItToolsDir>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmashIt.Core.Tests" />
  </ItemGroup>

  <!-- Bundled third-party tools (fetched by tools/fetch-tools.ps1) land in <output>\tools\. -->
  <ItemGroup>
    <Content Include="$(SmashItToolsDir)**\*" Link="tools\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="WarnMissingTools" BeforeTargets="Build" Condition="!Exists('$(SmashItToolsDir)oxipng.exe')">
    <Warning Text="Outils tiers absents (oxipng, pngquant, gifsicle, oxvg, jpegtran, cwebp, avifenc, qpdf) : lancez tools\fetch-tools.ps1. Seul le moteur Windows (WIC) sera disponible." />
  </Target>

  <ItemGroup>
    <Using Include="SmashIt.Core.Localization" />
  </ItemGroup>

</Project>
