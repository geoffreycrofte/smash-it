<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(SmashItTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SmashIt.App</RootNamespace>
    <AssemblyName>SmashIt</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SmashIt.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Own entry point (Program.cs): the splash screen shows before WinUI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Unpackaged + self-contained Windows App SDK: no MSIX, no signing, runs from a plain folder. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Without it, `dotnet publish` leaves out the compiled XAML (.xbf) and SmashIt.pri: the window then fails to load. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Only the languages the app ships in; the .NET runtime would otherwise add a dozen satellite folders. -->
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Default to the machine architecture when no platform is given (e.g. plain `dotnet build`). -->
  <PropertyGroup Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">
    <Platform Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">ARM64</Platform>
    <Platform Condition="'$(Platform)' != 'ARM64'">x64</Platform>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the Windows App SDK parts the app uses: the metapackage would also ship AI/ML (onnxruntime,
         DirectML), widgets and search, about 90 MB the app never loads. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmashIt.Core\SmashIt.Core.csproj" />
    <!-- View-models, texts and settings, shared with the macOS and Linux app. -->
    <ProjectReference Include="..\SmashIt.Presentation\SmashIt.Presentation.csproj" />
  </ItemGroup>

  <!-- Icon files, generated by tools/branding/make-icon.cs. -->
  <ItemGroup>
    <Content Include="Assets\SmashIt.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\SmashIt-titlebar.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\SmashIt-splash.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="SmashIt.Core.Localization" />
    <Using Include="SmashIt.Presentation" />
    <Using Include="SmashIt.Presentation.Services" />
  </ItemGroup>

</Project>
