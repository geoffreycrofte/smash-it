<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SmashIt.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SmashIt.App.ViewModels"
    Title="Smash It">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <Grid.Resources>
      <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,4" />
      </Style>
      <Style x:Key="SectionCardStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
      </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Title bar: the drag area is AppTitleBar only, so the settings button stays clickable. -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="CaptionButtonsColumn" Width="140" />
      </Grid.ColumnDefinitions>
      <Grid x:Name="AppTitleBar" Padding="16,0,0,0" Background="Transparent">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image x:Name="TitleBarIcon" Width="18" Height="18" />
          <TextBlock Text="Smash It" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
      <ToggleButton Grid.Column="1" Width="40" Height="32" Padding="0" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0"
                    IsChecked="{x:Bind ViewModel.IsSettingsOpen, Mode=TwoWay}"
                    ToolTipService.ToolTip="Réglages"
                    AutomationProperties.Name="Réglages">
        <FontIcon Glyph="&#xE713;" FontSize="16" />
      </ToggleButton>
    </Grid>

    <SplitView Grid.Row="1" PanePlacement="Right" DisplayMode="Inline" OpenPaneLength="360"
               IsPaneOpen="{x:Bind ViewModel.IsSettingsOpen, Mode=TwoWay}"
               PaneBackground="Transparent">

      <!-- Settings, one section per kind of file -->
      <SplitView.Pane>
        <ScrollViewer Padding="0,0,16,0">
          <StackPanel Spacing="16" Padding="4,0,0,16">
            <TextBlock Text="Réglages" Style="{StaticResource SubtitleTextBlockStyle}" />

            <StackPanel Style="{StaticResource SectionCardStyle}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xEB9F;" FontSize="16" />
                <TextBlock Text="Images" Style="{StaticResource SectionHeaderStyle}" />
              </StackPanel>
              <ToggleSwitch Header="Compression" OffContent="Sans perte" OnContent="Avec pertes"
                            IsOn="{x:Bind ViewModel.ImageLossy, Mode=TwoWay}" />
              <Slider Header="Qualité" Minimum="1" Maximum="100" StepFrequency="1" TickFrequency="10" TickPlacement="Outside"
                      IsEnabled="{x:Bind ViewModel.ImageLossy, Mode=OneWay}"
                      Value="{x:Bind ViewModel.ImageQuality, Mode=TwoWay}" />
              <ComboBox Header="Format de sortie" HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.OutputFormats}"
                        SelectedItem="{x:Bind ViewModel.SelectedOutputFormat, Mode=TwoWay}"
                        DisplayMemberPath="Label" />
              <ComboBox Header="Effort" HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.Efforts}"
                        SelectedItem="{x:Bind ViewModel.SelectedEffort, Mode=TwoWay}"
                        DisplayMemberPath="Label"
                        ToolTipService.ToolTip="Plus d'effort : fichiers plus petits, compression plus lente." />
              <CheckBox Content="Supprimer les métadonnées"
                        IsChecked="{x:Bind ViewModel.StripMetadata, Mode=TwoWay}"
                        ToolTipService.ToolTip="Retire EXIF (appareil, date, GPS…), XMP, IPTC et commentaires. Le profil couleur et l'orientation sont toujours conservés." />
            </StackPanel>

            <StackPanel Style="{StaticResource SectionCardStyle}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xEA90;" FontSize="16" />
                <TextBlock Text="PDF" Style="{StaticResource SectionHeaderStyle}" />
              </StackPanel>
              <ToggleSwitch Header="Images du document" OffContent="Sans perte" OnContent="Avec pertes"
                            IsOn="{x:Bind ViewModel.PdfLossy, Mode=TwoWay}" />
              <Slider Header="Qualité des images" Minimum="1" Maximum="100" StepFrequency="1" TickFrequency="10" TickPlacement="Outside"
                      IsEnabled="{x:Bind ViewModel.PdfLossy, Mode=OneWay}"
                      Value="{x:Bind ViewModel.PdfQuality, Mode=TwoWay}" />
              <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"
                         Text="Texte, polices, liens et formulaires ne sont jamais modifiés. Les PDF signés ou chiffrés sont ignorés." />
            </StackPanel>

            <StackPanel Style="{StaticResource SectionCardStyle}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE714;" FontSize="16" />
                <TextBlock Text="Vidéo" Style="{StaticResource SectionHeaderStyle}" />
              </StackPanel>
              <Slider Header="Qualité" Minimum="1" Maximum="100" StepFrequency="1" TickFrequency="10" TickPlacement="Outside"
                      Value="{x:Bind ViewModel.VideoQuality, Mode=TwoWay}" />
              <ComboBox Header="Codec" HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.VideoCodecs}"
                        SelectedItem="{x:Bind ViewModel.SelectedVideoCodec, Mode=TwoWay}"
                        DisplayMemberPath="Label" />
              <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"
                         Text="Réencodage en MP4 avec l'encodeur de Windows. Les MOV, MKV et AVI deviennent des MP4, seulement s'ils y gagnent." />
            </StackPanel>

            <StackPanel Style="{StaticResource SectionCardStyle}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                <TextBlock Text="Tous les fichiers" Style="{StaticResource SectionHeaderStyle}" />
              </StackPanel>
              <CheckBox Content="Garder les originaux"
                        IsChecked="{x:Bind ViewModel.KeepOriginal, Mode=TwoWay}" />
              <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"
                         Text="Coché : le résultat est enregistré à côté sous le nom « nom-compressed.ext ». Décoché : il remplace l'original, qui part dans la Corbeille." />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </SplitView.Pane>

      <!-- File list -->
      <Grid Margin="16,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="16,10" ColumnSpacing="12"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="40" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="1" Text="Fichier" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock Grid.Column="2" Text="Taille" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock Grid.Column="3" Text="Optimisé" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock Grid.Column="4" Text="Gain" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Files}" SelectionMode="Extended" Padding="0,4"
                  DoubleTapped="OnFileDoubleTapped">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:FileItem">
              <Grid ColumnSpacing="12" Padding="0,6" ToolTipService.ToolTip="{x:Bind Message, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <ProgressRing IsActive="{x:Bind IsWorking, Mode=OneWay}" Width="16" Height="16" />
                <FontIcon Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontSize="14" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{x:Bind Folder}" TextTrimming="CharacterEllipsis"
                             Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind OriginalSizeText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{x:Bind FinalSizeText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{x:Bind GainText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Button Grid.Column="5" Width="32" Height="32" Padding="0" HorizontalAlignment="Right"
                        Background="Transparent" BorderThickness="0"
                        Visibility="{x:Bind CanPreview, Mode=OneWay}" Click="OnPreviewClick"
                        ToolTipService.ToolTip="Comparer avant / après"
                        AutomationProperties.Name="Comparer avant / après">
                  <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                </Button>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state -->
        <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
          <FontIcon Glyph="&#xE898;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
          <TextBlock Text="Déposez vos images, PDF et vidéos ici" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
          <TextBlock Text="Fichiers ou dossiers. JPEG, PNG, WebP, AVIF, HEIC, TIFF, GIF, PDF, MP4, MOV, MKV, AVI."
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"
                     TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
        </StackPanel>
      </Grid>
    </SplitView>

    <!-- Footer -->
    <Grid Grid.Row="2" Padding="16,12" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Button Grid.Column="1" Click="OnAddFilesClick">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE710;" FontSize="14" />
          <TextBlock Text="Ajouter" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Command="{x:Bind ViewModel.ReprocessCommand}" ToolTipService.ToolTip="Recompresser avec les réglages actuels">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE72C;" FontSize="14" />
          <TextBlock Text="Recompresser" />
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Command="{x:Bind ViewModel.ClearCommand}" ToolTipService.ToolTip="Vider la liste">
        <FontIcon Glyph="&#xE74D;" FontSize="14" />
      </Button>
    </Grid>
  </Grid>
</Window>
