<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SmashIt.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:SmashIt.App"
    xmlns:vm="using:SmashIt.App.ViewModels"
    xmlns:services="using:SmashIt.App.Services"
    Title="Smash It">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <Grid.Resources>
      <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,4" />
      </Style>
      <Style x:Key="SectionCardStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
      </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Grid x:Name="AppTitleBar" Padding="16,0,0,0" Background="Transparent">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image x:Name="TitleBarIcon" Width="18" Height="18" AutomationProperties.AccessibilityView="Raw" />
        <TextBlock Text="Smash It" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Files on the left, settings on the right when open. In this order in the markup, so that Tab follows the
         screen: files, settings, then the footer. -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

      <!-- New version available, or just updated -->
      <InfoBar Margin="16,0,16,12"
               IsOpen="{x:Bind ViewModel.Updates.IsBannerOpen, Mode=TwoWay}"
               Severity="{x:Bind ViewModel.Updates.BannerSeverity, Mode=OneWay}"
               Title="{x:Bind ViewModel.Updates.BannerTitle, Mode=OneWay}"
               Message="{x:Bind ViewModel.Updates.BannerMessage, Mode=OneWay}"
               IsClosable="{x:Bind ViewModel.Updates.IsIdle, Mode=OneWay}">
        <StackPanel Spacing="8" Margin="0,0,0,12">
          <ProgressBar Value="{x:Bind ViewModel.Updates.DownloadProgress, Mode=OneWay}" Maximum="100"
                       Visibility="{x:Bind ViewModel.Updates.IsDownloading, Mode=OneWay}" />
          <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Updates.IsIdle, Mode=OneWay}">
            <Button Style="{StaticResource AccentButtonStyle}" Content="{x:Bind vm:UpdateViewModel.InstallLabel}"
                    Command="{x:Bind ViewModel.Updates.InstallCommand}"
                    Visibility="{x:Bind ViewModel.Updates.IsUpdateOffered, Mode=OneWay}" />
            <Button Content="{x:Bind app:Strings.WhatsNew}" Command="{x:Bind ViewModel.Updates.ShowNotesCommand}"
                    Visibility="{x:Bind ViewModel.Updates.HasNotes, Mode=OneWay}" />
            <Button Content="{x:Bind app:Strings.SkipVersion}" Command="{x:Bind ViewModel.Updates.SkipCommand}"
                    Visibility="{x:Bind ViewModel.Updates.IsUpdateOffered, Mode=OneWay}" />
          </StackPanel>
        </StackPanel>
      </InfoBar>

      <!-- File list -->
      <Grid Grid.Row="1" Margin="16,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Column headers: only above files. -->
        <Grid Padding="16,10" ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{x:Bind services:TextScale.Width(40, services:TextScale.Current.Factor), Mode=OneWay}" />
            <ColumnDefinition Width="{x:Bind services:TextScale.Width(24, services:TextScale.Current.Factor), Mode=OneWay}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{x:Bind services:TextScale.Width(100, services:TextScale.Current.Factor), Mode=OneWay}" />
            <ColumnDefinition Width="{x:Bind services:TextScale.Width(100, services:TextScale.Current.Factor), Mode=OneWay}" />
            <ColumnDefinition Width="{x:Bind services:TextScale.Width(150, services:TextScale.Current.Factor), Mode=OneWay}" />
            <ColumnDefinition Width="{x:Bind services:TextScale.Width(40, services:TextScale.Current.Factor), Mode=OneWay}" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="2" Text="{x:Bind app:Strings.ColumnFile}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock Grid.Column="3" Text="{x:Bind app:Strings.ColumnSize}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock Grid.Column="4" Text="{x:Bind app:Strings.ColumnOptimized}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock Grid.Column="5" Text="{x:Bind app:Strings.ColumnGain}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <ListView x:Name="FileList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Files}" SelectionMode="Extended" Padding="0,4"
                  Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay}"
                  DoubleTapped="OnFileDoubleTapped" PreviewKeyDown="OnFileListKeyDown"
                  AutomationProperties.Name="{x:Bind app:Strings.FileList}">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:FileItem">
              <Grid ColumnSpacing="12" Padding="0,6" ToolTipService.ToolTip="{x:Bind Message, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{x:Bind services:TextScale.Width(40, services:TextScale.Current.Factor), Mode=OneWay}" />
                  <ColumnDefinition Width="{x:Bind services:TextScale.Width(24, services:TextScale.Current.Factor), Mode=OneWay}" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="{x:Bind services:TextScale.Width(100, services:TextScale.Current.Factor), Mode=OneWay}" />
                  <ColumnDefinition Width="{x:Bind services:TextScale.Width(100, services:TextScale.Current.Factor), Mode=OneWay}" />
                  <ColumnDefinition Width="{x:Bind services:TextScale.Width(150, services:TextScale.Current.Factor), Mode=OneWay}" />
                  <ColumnDefinition Width="{x:Bind services:TextScale.Width(40, services:TextScale.Current.Factor), Mode=OneWay}" />
                </Grid.ColumnDefinitions>

                <!-- Thumbnail, or an icon for the kind of file when Windows has no preview. -->
                <Border Width="40" Height="40" CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                  <Grid>
                    <FontIcon Glyph="{x:Bind KindGlyph}" FontSize="18"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Visibility="{x:Bind ShowKindGlyph, Mode=OneWay}" />
                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"
                           Visibility="{x:Bind HasThumbnail, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                  </Grid>
                </Border>

                <ProgressRing Grid.Column="1" IsActive="{x:Bind IsWorking, Mode=OneWay}" Width="16" Height="16" />
                <FontIcon Grid.Column="1" Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontSize="14" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                  <TextBlock Text="{x:Bind Folder}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                             ToolTipService.ToolTip="{x:Bind Folder}"
                             Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{x:Bind OriginalSizeText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{x:Bind FinalSizeText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{x:Bind GainText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Button Grid.Column="6" Width="32" Height="32" Padding="0" HorizontalAlignment="Right"
                        Background="Transparent" BorderThickness="0"
                        Visibility="{x:Bind CanPreview, Mode=OneWay}" Click="OnPreviewClick"
                        ToolTipService.ToolTip="{x:Bind app:Strings.Compare}"
                        AutomationProperties.Name="{x:Bind app:Strings.Compare}">
                  <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                </Button>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state -->
        <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
          <FontIcon Glyph="&#xE898;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
          <TextBlock Text="{x:Bind app:Strings.EmptyTitle}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
          <TextBlock Text="{x:Bind app:Strings.EmptyDetails}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"
                     TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
          <!-- For those who don't or can't drag and drop. -->
          <Button x:Name="EmptyAddButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,12,0,0"
                  Click="OnAddFilesClick" AutomationProperties.Name="{x:Bind app:Strings.AddFiles}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE710;" FontSize="14" />
              <TextBlock Text="{x:Bind app:Strings.AddFiles}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
      </Grid>

      <!-- Settings, one section per kind of file -->
      <ScrollViewer Grid.Column="1" Width="{x:Bind services:TextScale.Length(360, services:TextScale.Current.Factor), Mode=OneWay}" Padding="0,0,16,0" Visibility="{x:Bind ViewModel.IsSettingsOpen, Mode=OneWay}">
        <StackPanel Spacing="16" Padding="4,0,0,16">
          <TextBlock Text="{x:Bind app:Strings.Settings}" Style="{StaticResource SubtitleTextBlockStyle}" />

          <!-- Preset: one choice for every kind of file; touching a setting below turns it into "Custom". -->
          <StackPanel Style="{StaticResource SectionCardStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE71D;" FontSize="16" />
              <TextBlock Text="{x:Bind app:Strings.Preset}" Style="{StaticResource SectionHeaderStyle}" />
            </StackPanel>
            <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Bind app:Strings.Preset}"
                      ItemsSource="{x:Bind ViewModel.Presets}"
                      SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                      DisplayMemberPath="Label" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"
                       Text="{x:Bind ViewModel.SelectedPreset.Description, Mode=OneWay}" />
          </StackPanel>

          <StackPanel Style="{StaticResource SectionCardStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xEB9F;" FontSize="16" />
              <TextBlock Text="{x:Bind app:Strings.Images}" Style="{StaticResource SectionHeaderStyle}" />
            </StackPanel>
            <ToggleSwitch Header="{x:Bind app:Strings.Compression}"
                          OffContent="{x:Bind app:Strings.Lossless}" OnContent="{x:Bind app:Strings.Lossy}"
                          IsOn="{x:Bind ViewModel.ImageLossy, Mode=TwoWay}" />
            <Slider Header="{x:Bind app:Strings.Quality}" AutomationProperties.Name="{x:Bind app:Strings.ImageQualityName}" Minimum="1" Maximum="100" StepFrequency="1" TickFrequency="10" TickPlacement="Outside"
                    IsEnabled="{x:Bind ViewModel.ImageLossy, Mode=OneWay}"
                    Value="{x:Bind ViewModel.ImageQuality, Mode=TwoWay}" />
            <ComboBox Header="{x:Bind app:Strings.ImageSize}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{x:Bind app:Strings.ImageSizeName}"
                      IsEnabled="{x:Bind ViewModel.ImageLossy, Mode=OneWay}"
                      ItemsSource="{x:Bind ViewModel.ImageSizes}"
                      SelectedItem="{x:Bind ViewModel.SelectedImageSize, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      ToolTipService.ToolTip="{x:Bind app:Strings.ImageSizeTip}" />
            <ComboBox Header="{x:Bind app:Strings.OutputFormat}" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.OutputFormats}"
                      SelectedItem="{x:Bind ViewModel.SelectedOutputFormat, Mode=TwoWay}"
                      DisplayMemberPath="Label" />
            <ComboBox Header="{x:Bind app:Strings.AnimatedGifs}" HorizontalAlignment="Stretch"
                      IsEnabled="{x:Bind ViewModel.ImageLossy, Mode=OneWay}"
                      ItemsSource="{x:Bind ViewModel.AnimatedGifChoices}"
                      SelectedItem="{x:Bind ViewModel.SelectedAnimatedGif, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      ToolTipService.ToolTip="{x:Bind app:Strings.AnimatedGifsTip}" />
            <ComboBox Header="{x:Bind app:Strings.Effort}" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.Efforts}"
                      SelectedItem="{x:Bind ViewModel.SelectedEffort, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      ToolTipService.ToolTip="{x:Bind app:Strings.EffortTip}" />
            <CheckBox Content="{x:Bind app:Strings.StripMetadata}"
                      IsChecked="{x:Bind ViewModel.StripMetadata, Mode=TwoWay}"
                      ToolTipService.ToolTip="{x:Bind app:Strings.StripMetadataTip}" />
            <Expander Header="{x:Bind app:Strings.FineTuning}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"
                           Text="{x:Bind app:Strings.FineTuningNote}" />
                <ComboBox Header="{x:Bind app:Strings.ColorDetail}" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{x:Bind app:Strings.ColorDetailName}"
                          IsEnabled="{x:Bind ViewModel.ImageLossy, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.ColorDetails}"
                          SelectedItem="{x:Bind ViewModel.SelectedColorDetail, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          ToolTipService.ToolTip="{x:Bind app:Strings.ColorDetailTip}" />
                <ComboBox Header="{x:Bind app:Strings.JpegEncoding}" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.JpegEncodings}"
                          SelectedItem="{x:Bind ViewModel.SelectedJpegEncoding, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          ToolTipService.ToolTip="{x:Bind app:Strings.JpegEncodingTip}" />
                <ComboBox Header="{x:Bind app:Strings.MaxColors}" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{x:Bind app:Strings.MaxColorsName}"
                          IsEnabled="{x:Bind ViewModel.ImageLossy, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.MaxColorsChoices}"
                          SelectedItem="{x:Bind ViewModel.SelectedMaxColors, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          ToolTipService.ToolTip="{x:Bind app:Strings.MaxColorsTip}" />
                <CheckBox Content="{x:Bind app:Strings.Dithering}"
                          IsEnabled="{x:Bind ViewModel.ImageLossy, Mode=OneWay}"
                          IsChecked="{x:Bind ViewModel.Dithering, Mode=TwoWay}"
                          ToolTipService.ToolTip="{x:Bind app:Strings.DitheringTip}" />
                <CheckBox Content="{x:Bind app:Strings.Zopfli}"
                          IsChecked="{x:Bind ViewModel.Zopfli, Mode=TwoWay}"
                          ToolTipService.ToolTip="{x:Bind app:Strings.ZopfliTip}" />
              </StackPanel>
            </Expander>
          </StackPanel>

          <StackPanel Style="{StaticResource SectionCardStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xEA90;" FontSize="16" />
              <TextBlock Text="{x:Bind app:Strings.Pdf}" Style="{StaticResource SectionHeaderStyle}" />
            </StackPanel>
            <ToggleSwitch Header="{x:Bind app:Strings.PdfImages}"
                          OffContent="{x:Bind app:Strings.Lossless}" OnContent="{x:Bind app:Strings.Lossy}"
                          IsOn="{x:Bind ViewModel.PdfLossy, Mode=TwoWay}" />
            <Slider Header="{x:Bind app:Strings.PdfQuality}" AutomationProperties.Name="{x:Bind app:Strings.PdfQualityName}" Minimum="1" Maximum="100" StepFrequency="1" TickFrequency="10" TickPlacement="Outside"
                    IsEnabled="{x:Bind ViewModel.PdfLossy, Mode=OneWay}"
                    Value="{x:Bind ViewModel.PdfQuality, Mode=TwoWay}" />
            <ComboBox Header="{x:Bind app:Strings.PdfResolution}" HorizontalAlignment="Stretch"
                      IsEnabled="{x:Bind ViewModel.PdfLossy, Mode=OneWay}"
                      ItemsSource="{x:Bind ViewModel.PdfResolutions}"
                      SelectedItem="{x:Bind ViewModel.SelectedPdfResolution, Mode=TwoWay}"
                      DisplayMemberPath="Label" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"
                       Text="{x:Bind app:Strings.PdfNote}" />
          </StackPanel>

          <StackPanel Style="{StaticResource SectionCardStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE714;" FontSize="16" />
              <TextBlock Text="{x:Bind app:Strings.Video}" Style="{StaticResource SectionHeaderStyle}" />
            </StackPanel>
            <Slider Header="{x:Bind app:Strings.Quality}" AutomationProperties.Name="{x:Bind app:Strings.VideoQualityName}" Minimum="1" Maximum="100" StepFrequency="1" TickFrequency="10" TickPlacement="Outside"
                    Value="{x:Bind ViewModel.VideoQuality, Mode=TwoWay}" />
            <ComboBox Header="{x:Bind app:Strings.VideoResolution}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{x:Bind app:Strings.VideoResolutionName}"
                      ItemsSource="{x:Bind ViewModel.VideoResolutions}"
                      SelectedItem="{x:Bind ViewModel.SelectedVideoResolution, Mode=TwoWay}"
                      DisplayMemberPath="Label" />
            <ComboBox Header="{x:Bind app:Strings.Codec}" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.VideoCodecs}"
                      SelectedItem="{x:Bind ViewModel.SelectedVideoCodec, Mode=TwoWay}"
                      DisplayMemberPath="Label" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"
                       Text="{x:Bind app:Strings.VideoNote}" />
          </StackPanel>

          <StackPanel Style="{StaticResource SectionCardStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE8B7;" FontSize="16" />
              <TextBlock Text="{x:Bind app:Strings.AllFiles}" Style="{StaticResource SectionHeaderStyle}" />
            </StackPanel>
            <CheckBox Content="{x:Bind app:Strings.KeepOriginals}"
                      IsChecked="{x:Bind ViewModel.KeepOriginal, Mode=TwoWay}" />
            <RadioButtons Header="{x:Bind app:Strings.SaveResults}"
                          SelectedIndex="{x:Bind ViewModel.OutputLocationIndex, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.KeepOriginal, Mode=OneWay}">
              <RadioButton Content="{x:Bind app:Strings.NextToOriginals}" />
              <RadioButton Content="{x:Bind app:Strings.InCompressedFolder}" />
            </RadioButtons>
            <CheckBox Margin="28,-4,0,0"
                      IsChecked="{x:Bind ViewModel.CopyAlreadyOptimal, Mode=TwoWay}"
                      IsEnabled="{x:Bind ViewModel.KeepOriginal, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.SavesInCompressedFolder, Mode=OneWay}">
              <TextBlock Text="{x:Bind app:Strings.CopyAlreadyOptimal}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox Content="{x:Bind app:Strings.AskOutputLocation}"
                      IsChecked="{x:Bind ViewModel.AskOutputLocation, Mode=TwoWay}"
                      IsEnabled="{x:Bind ViewModel.KeepOriginal, Mode=OneWay}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"
                       Text="{x:Bind app:Strings.KeepOriginalsNote}" />
          </StackPanel>

          <StackPanel Style="{StaticResource SectionCardStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xEC50;" FontSize="16" />
              <TextBlock Text="{x:Bind app:Strings.Explorer}" Style="{StaticResource SectionHeaderStyle}" />
            </StackPanel>
            <ToggleSwitch Header="{x:Bind app:Strings.ContextMenuToggle}"
                          IsOn="{x:Bind ViewModel.ContextMenuEnabled, Mode=TwoWay}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"
                       Text="{x:Bind app:Strings.ContextMenuNote}" />
          </StackPanel>

          <StackPanel Style="{StaticResource SectionCardStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xF2B7;" FontSize="16" />
              <TextBlock Text="{x:Bind app:Strings.Language}" Style="{StaticResource SectionHeaderStyle}" />
            </StackPanel>
            <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Bind app:Strings.Language}"
                      ItemsSource="{x:Bind ViewModel.Languages}"
                      SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                      DisplayMemberPath="Label" />
          </StackPanel>

          <!-- About: author, license, and the open source projects the app relies on -->
          <StackPanel Style="{StaticResource SectionCardStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE946;" FontSize="16" />
              <TextBlock Text="{x:Bind app:Strings.About}" Style="{StaticResource SectionHeaderStyle}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Bind app:Strings.AppNameAndVersion}" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <CheckBox Content="{x:Bind app:Strings.CheckForUpdates}" Margin="0,4,0,0"
                        IsChecked="{x:Bind ViewModel.Updates.CheckAtStartup, Mode=TwoWay}" />
              <Button Content="{x:Bind app:Strings.CheckNow}" Command="{x:Bind ViewModel.Updates.CheckNowCommand}" />
              <TextBlock Text="{x:Bind ViewModel.Updates.Status, Mode=OneWay}" TextWrapping="Wrap"
                         AutomationProperties.LiveSetting="Polite" />
              <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"
                         Margin="0,0,0,8" Text="{x:Bind app:Strings.UpdatesNote}" />
              <TextBlock TextWrapping="Wrap">
                <Run Text="{x:Bind app:Strings.CreditPrefix}" /><Hyperlink NavigateUri="https://geoffreycrofte.com/project/smash-it"
                           ToolTipService.ToolTip="geoffreycrofte.com/project/smash-it"><Run Text="Crofte Studio" /></Hyperlink><Run Text=" (Geoffrey Crofte)." />
              </TextBlock>
              <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <Run Text="{x:Bind app:Strings.FreeSoftware}" /><Hyperlink NavigateUri="https://github.com/geoffreycrofte/smash-it"
                           ToolTipService.ToolTip="github.com/geoffreycrofte/smash-it"><Run Text="{x:Bind app:Strings.SourceCode}" /></Hyperlink>
              </TextBlock>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Bind app:Strings.OpenSourceProjects}" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock><Hyperlink NavigateUri="https://github.com/oxipng/oxipng">oxipng</Hyperlink><Run Text=" · MIT" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></TextBlock>
              <TextBlock><Hyperlink NavigateUri="https://pngquant.org">pngquant</Hyperlink><Run Text=" · GPL-3.0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></TextBlock>
              <TextBlock><Hyperlink NavigateUri="https://www.lcdf.org/gifsicle/">gifsicle</Hyperlink><Run Text=" · GPL-2.0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></TextBlock>
              <TextBlock><Hyperlink NavigateUri="https://github.com/noahbald/oxvg">oxvg</Hyperlink><Run Text=" · MIT" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></TextBlock>
              <TextBlock><Hyperlink NavigateUri="https://github.com/libjpeg-turbo/libjpeg-turbo">libjpeg-turbo</Hyperlink><Run Text=" · IJG, BSD, zlib" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></TextBlock>
              <TextBlock><Hyperlink NavigateUri="https://chromium.googlesource.com/webm/libwebp">libwebp</Hyperlink><Run Text=" · BSD-3-Clause" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></TextBlock>
              <TextBlock><Hyperlink NavigateUri="https://github.com/AOMediaCodec/libavif">libavif</Hyperlink><Run Text=" · BSD-2-Clause" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></TextBlock>
              <TextBlock><Hyperlink NavigateUri="https://github.com/qpdf/qpdf">qpdf</Hyperlink><Run Text=" · Apache-2.0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></TextBlock>
              <TextBlock><Hyperlink NavigateUri="https://ffmpeg.org">FFmpeg</Hyperlink><Run Text=" · GPL-3.0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></TextBlock>
              <TextBlock><Hyperlink NavigateUri="https://gitlab.com/AOMediaCodec/SVT-AV1">SVT-AV1</Hyperlink><Run Text=" · BSD-3-Clause" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></TextBlock>
              <TextBlock><Hyperlink NavigateUri="https://github.com/dotnet/runtime">.NET</Hyperlink><Run Text=" · MIT" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></TextBlock>
              <TextBlock><Hyperlink NavigateUri="https://github.com/CommunityToolkit/dotnet">CommunityToolkit.Mvvm</Hyperlink><Run Text=" · MIT" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></TextBlock>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Footer: summary, then settings and the actions. -->
    <Grid Grid.Row="2" Padding="16,12,16,12" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <!-- Empty list: the credit (the drop hint is already in the middle); otherwise the summary, with a spinner
           while files are being compressed. -->
      <Grid ColumnSpacing="10" Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Command="{x:Bind ViewModel.StopCommand}" VerticalAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind app:Strings.Stop}" AutomationProperties.Name="{x:Bind app:Strings.Stop}">
          <FontIcon Glyph="&#xE71A;" FontSize="14" />
        </Button>
        <ProgressRing Grid.Column="1" Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
      </Grid>
      <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
        <Run Text="{x:Bind app:Strings.CreditPrefix}" /><Hyperlink NavigateUri="https://geoffreycrofte.com/project/smash-it" UnderlineStyle="None"
                   ToolTipService.ToolTip="geoffreycrofte.com/project/smash-it"><Run Text="Crofte Studio" /></Hyperlink>
      </TextBlock>
      <!-- The preset, at hand without opening Settings. -->
      <ComboBox Grid.Column="1" MinWidth="{x:Bind services:TextScale.Length(210, services:TextScale.Current.Factor), Mode=OneWay}" VerticalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.Presets}"
                SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                DisplayMemberPath="Label"
                AutomationProperties.Name="{x:Bind app:Strings.Preset}"
                ToolTipService.ToolTip="{x:Bind ViewModel.SelectedPreset.Description, Mode=OneWay}" />
      <!-- Settings, then the list's actions once it has files (the empty list has its own "Add files" button).
           The actions come and go as one group with their spacing on the left, so nothing is left at the right
           edge when they're hidden: a Grid column would keep its ColumnSpacing even when empty. -->
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <!-- Icon-only buttons stretch to the height of the labelled ones. -->
        <ToggleButton VerticalAlignment="Stretch"
                      IsChecked="{x:Bind ViewModel.IsSettingsOpen, Mode=TwoWay}"
                      ToolTipService.ToolTip="{x:Bind app:Strings.Settings}"
                      AutomationProperties.Name="{x:Bind app:Strings.Settings}">
          <FontIcon Glyph="&#xE713;" FontSize="14" />
        </ToggleButton>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,0,0"
                    Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay}">
          <Button Click="OnAddFilesClick" AutomationProperties.Name="{x:Bind app:Strings.Add}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE710;" FontSize="14" />
              <TextBlock Text="{x:Bind app:Strings.Add}" />
            </StackPanel>
          </Button>
          <Button Command="{x:Bind ViewModel.ReprocessCommand}" ToolTipService.ToolTip="{x:Bind app:Strings.RecompressTip}"
                  AutomationProperties.Name="{x:Bind app:Strings.Recompress}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE72C;" FontSize="14" />
              <TextBlock Text="{x:Bind app:Strings.Recompress}" />
            </StackPanel>
          </Button>
          <Button Command="{x:Bind ViewModel.ClearCommand}" VerticalAlignment="Stretch"
                  ToolTipService.ToolTip="{x:Bind app:Strings.Clear}" AutomationProperties.Name="{x:Bind app:Strings.Clear}">
            <FontIcon Glyph="&#xE74D;" FontSize="14" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
