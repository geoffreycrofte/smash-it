<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SmashIt.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SmashIt.App.ViewModels"
    Title="Smash It">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Title bar (content extends into it) -->
    <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <FontIcon Glyph="&#xE945;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <TextBlock Text="Smash It" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Settings -->
    <Grid Grid.Row="1" Margin="16,0,16,12" Padding="16,12" ColumnSpacing="24" RowSpacing="8"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
          CornerRadius="{StaticResource OverlayCornerRadius}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="160" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ToggleSwitch Header="Compression" OffContent="Sans perte" OnContent="Avec pertes"
                    IsOn="{x:Bind ViewModel.IsLossy, Mode=TwoWay}" />

      <Slider Grid.Column="1" Header="Qualité" Minimum="1" Maximum="100" StepFrequency="1"
              TickFrequency="10" TickPlacement="Outside" VerticalAlignment="Center"
              IsEnabled="{x:Bind ViewModel.IsLossy, Mode=OneWay}"
              Value="{x:Bind ViewModel.Quality, Mode=TwoWay}" />

      <ComboBox Grid.Column="2" Header="Format de sortie" MinWidth="180" VerticalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.OutputFormats}"
                SelectedItem="{x:Bind ViewModel.SelectedOutputFormat, Mode=TwoWay}"
                DisplayMemberPath="Label" />

      <ComboBox Grid.Column="3" Header="Effort" MinWidth="140" VerticalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.Efforts}"
                SelectedItem="{x:Bind ViewModel.SelectedEffort, Mode=TwoWay}"
                DisplayMemberPath="Label"
                ToolTipService.ToolTip="Plus d'effort : fichiers plus petits, compression plus lente." />

      <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="24">
        <ComboBox Header="Codec vidéo" MinWidth="220"
                  ItemsSource="{x:Bind ViewModel.VideoCodecs}"
                  SelectedItem="{x:Bind ViewModel.SelectedVideoCodec, Mode=TwoWay}"
                  DisplayMemberPath="Label"
                  ToolTipService.ToolTip="Les vidéos sont réencodées en MP4 avec l'encodeur de Windows (mode « Avec pertes » uniquement)." />
        <CheckBox Content="Supprimer les métadonnées" VerticalAlignment="Bottom"
                  IsChecked="{x:Bind ViewModel.StripMetadata, Mode=TwoWay}"
                  ToolTipService.ToolTip="Retire EXIF (appareil, date, GPS…), XMP, IPTC et commentaires. Le profil couleur et l'orientation sont toujours conservés." />
        <CheckBox Content="Garder les originaux" VerticalAlignment="Bottom"
                  IsChecked="{x:Bind ViewModel.KeepOriginal, Mode=TwoWay}"
                  ToolTipService.ToolTip="Les fichiers compressés sont enregistrés à côté sous le nom « nom-compressed.ext ». Sinon, les originaux partent dans la Corbeille." />
      </StackPanel>
    </Grid>

    <!-- File list -->
    <Grid Grid.Row="2" Margin="16,0"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
          CornerRadius="{StaticResource OverlayCornerRadius}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Padding="16,10" ColumnSpacing="12"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1" Text="Fichier" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Grid.Column="2" Text="Taille" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Grid.Column="3" Text="Optimisé" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Grid.Column="4" Text="Gain" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </Grid>

      <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Files}" SelectionMode="Extended" Padding="0,4">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="vm:FileItem">
            <Grid ColumnSpacing="12" Padding="0,6" ToolTipService.ToolTip="{x:Bind Message, Mode=OneWay}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="150" />
              </Grid.ColumnDefinitions>
              <ProgressRing IsActive="{x:Bind IsWorking, Mode=OneWay}" Width="16" Height="16" />
              <FontIcon Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontSize="14" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Folder}" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{x:Bind OriginalSizeText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="{x:Bind FinalSizeText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="{x:Bind GainText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <!-- Empty state -->
      <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
        <FontIcon Glyph="&#xE898;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        <TextBlock Text="Déposez vos images, PDF et vidéos ici" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
        <TextBlock Text="Fichiers ou dossiers. JPEG, PNG, WebP, AVIF, HEIC, TIFF, GIF, PDF, MP4, MOV, MKV, AVI."
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Footer -->
    <Grid Grid.Row="3" Padding="16,12" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Button Grid.Column="1" Click="OnAddFilesClick">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE710;" FontSize="14" />
          <TextBlock Text="Ajouter" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Command="{x:Bind ViewModel.ReprocessCommand}" ToolTipService.ToolTip="Recompresser avec les réglages actuels">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE72C;" FontSize="14" />
          <TextBlock Text="Recompresser" />
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Command="{x:Bind ViewModel.ClearCommand}" ToolTipService.ToolTip="Vider la liste">
        <FontIcon Glyph="&#xE74D;" FontSize="14" />
      </Button>
    </Grid>
  </Grid>
</Window>
