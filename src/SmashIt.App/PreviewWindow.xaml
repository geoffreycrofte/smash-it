<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SmashIt.App.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:SmashIt.App"
    xmlns:controls="using:SmashIt.App.Controls">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid>
    <!-- Esc closes the preview, wherever the focus is. -->
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
      <KeyboardAccelerator Key="Z" Invoked="OnZoomKeyInvoked" />
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Image x:Name="TitleBarIcon" Width="18" Height="18" AutomationProperties.AccessibilityView="Raw" />
        <TextBlock x:Name="TitleText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Summary -->
    <Grid Grid.Row="1" Padding="16,0,16,12" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="FileNameText" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="SizesText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                 TextWrapping="Wrap" MaxWidth="460" Text="{x:Bind app:Strings.PreviewHint}" />
      <!-- Fit to the window, or one image pixel per screen pixel. -->
      <ToggleButton x:Name="ActualSizeButton" Grid.Column="2" VerticalAlignment="Bottom" IsEnabled="False"
                    Checked="OnActualSizeToggled" Unchecked="OnActualSizeToggled"
                    AutomationProperties.Name="{x:Bind app:Strings.ActualSizeName}"
                    ToolTipService.ToolTip="{x:Bind app:Strings.ActualSizeTip}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE71E;" FontSize="14" />
          <TextBlock Text="{x:Bind app:Strings.ActualSize}" />
        </StackPanel>
      </ToggleButton>
    </Grid>

    <!-- Comparison stage -->
    <controls:ResizeCursorGrid x:Name="Stage" Grid.Row="2" Margin="16,0,16,16"
                               Background="{ThemeResource LayerFillColorDefaultBrush}"
                               BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                               CornerRadius="{StaticResource OverlayCornerRadius}"
                               SizeChanged="OnStageSizeChanged"
                               PointerMoved="OnStagePointerMoved"
                               PointerReleased="OnStagePointerReleased"
                               PointerCaptureLost="OnStagePointerCaptureLost"
                               DoubleTapped="OnStageDoubleTapped">

      <!-- Both images share the same box, so they line up pixel for pixel. Fitted: large images shrink to fit,
           small ones keep their size, and nothing scrolls. At 100 %: real size, scrollable. -->
      <ScrollViewer x:Name="Scroller" ViewChanged="OnScrollerViewChanged"
                    HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                    ZoomMode="Disabled" IsTabStop="False">
        <Viewbox x:Name="ImageBox" StretchDirection="DownOnly" Stretch="Uniform" Margin="12">
          <Grid x:Name="ImageHost">
            <Image x:Name="AfterImage" Stretch="Fill" AutomationProperties.Name="{x:Bind app:Strings.AfterImageName}" />
            <Image x:Name="BeforeImage" Stretch="Fill" AutomationProperties.Name="{x:Bind app:Strings.BeforeImageName}" />
          </Grid>
        </Viewbox>
      </ScrollViewer>

      <Canvas x:Name="Overlay">
        <Border x:Name="SplitLine" Width="4" Background="White" BorderBrush="#66000000" BorderThickness="1,0" IsHitTestVisible="False" />

        <Border x:Name="BeforeBadge" Background="#B3000000" CornerRadius="4" Padding="8,3" IsHitTestVisible="False">
          <TextBlock x:Name="BeforeBadgeText" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}" />
        </Border>
        <Border x:Name="AfterBadge" Background="#B3000000" CornerRadius="4" Padding="8,3" IsHitTestVisible="False">
          <TextBlock x:Name="AfterBadgeText" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}" />
        </Border>

        <!-- Not hit-testable: a Button captures the pointer on press, which would stop the drag.
             The stage handles the mouse; the handle stays focusable for the keyboard. -->
        <Button x:Name="Handle" Width="40" Height="40" Padding="0" CornerRadius="20" IsHitTestVisible="False"
                Background="White" BorderBrush="#66000000" BorderThickness="1"
                AutomationProperties.Name="{x:Bind app:Strings.Divider}"
                ToolTipService.ToolTip="{x:Bind app:Strings.DividerTip}"
                KeyDown="OnHandleKeyDown">
          <StackPanel Orientation="Horizontal" Spacing="0">
            <FontIcon Glyph="&#xE76B;" FontSize="12" Foreground="Black" />
            <FontIcon Glyph="&#xE76C;" FontSize="12" Foreground="Black" />
          </StackPanel>
        </Button>
      </Canvas>

      <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <ProgressRing IsActive="True" />
        <TextBlock x:Name="StatusText" Text="{x:Bind app:Strings.Loading}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="480" TextAlignment="Center" />
      </StackPanel>
    </controls:ResizeCursorGrid>
  </Grid>
</Window>
