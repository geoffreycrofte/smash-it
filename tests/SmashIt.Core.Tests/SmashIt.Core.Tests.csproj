<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows (WIC, Media Foundation) and plain .NET (libvips), as the Core is built: the second one is what
         macOS and Linux run. -->
    <TargetFrameworks>$(SmashItTargetFramework);$(SmashItPortableTargetFramework)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <!-- Builds and validates real PowerPoint files in the presentation tests. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SmashIt.Core\SmashIt.Core.csproj" />
  </ItemGroup>

  <!-- Engines and helpers that only exist on Windows. Tests mixing both use #if WINDOWS. -->
  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' != 'windows'">
    <Compile Remove="WicImageCompressorTests.cs;VideoCompressorTests.cs;ExplorerContextMenuTests.cs;TestVideo.cs" />
  </ItemGroup>
  <!-- And the other way round: the macOS and Linux trash. -->
  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'windows'">
    <Compile Remove="TrashTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="SmashIt.Core.Localization" />
  </ItemGroup>

</Project>
